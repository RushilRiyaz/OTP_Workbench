    "@types/react-dom": "^19",
    "@types/selenium-webdriver": "^4.1.28",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.0.6",
    "selenium-webdriver": "^4.27.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "wait-on": "^8.0.2"
